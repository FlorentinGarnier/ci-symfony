# /srv/<appli>/<environnement>/app.env : variables de l'application (mode 600). Propres à chaque environnement.
APP_ENV=prod
APP_DEBUG=0
# openssl rand -hex 32
APP_SECRET=
DATABASE_URL=postgresql://appli:REMPLACER@database:5432/appli?serverVersion=16&charset=utf8
DEFAULT_URI=https://staging.example.com
# Réseau réel de Traefik
TRUSTED_PROXIES=172.16.0.0/12
MESSENGER_TRANSPORT_DSN=doctrine://default
# Staging : transport nul ou capture, jamais de vrais envois.
MAILER_DSN=null://null
