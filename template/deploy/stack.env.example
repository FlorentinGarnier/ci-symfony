# /srv/<appli>/<environnement>/stack.env : variables lues par Docker Compose et par <appli>-deploy (mode 600).
COMPOSE_PROJECT_NAME=appli-staging
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
APP_HOST=staging.example.com
# Staging : libellé d'un seul mot, comptes dans ./htpasswd (htpasswd -B -c htpasswd recette). Production : off.
AUTH_BASIC=Recette
APP_CPUS=1.0
APP_MEMORY=1g
POSTGRES_DB=appli
POSTGRES_USER=appli
# openssl rand -hex 32
POSTGRES_PASSWORD=REMPLACER
# Page interrogée dans le conteneur web après le déploiement (par défaut /healthz).
HEALTHCHECK_PATH=/healthz
# Services laissés en marche pendant le déploiement, en plus de la base (séparés par des espaces).
KEEP_RUNNING=
# Commande facultative qui copie la sauvegarde hors du serveur ; reçoit le chemin du fichier en argument.
BACKUP_UPLOAD_CMD=
